# Copy to .env and fill in. Compose's `ukiyo_service` overrides DATABASE_URL
# automatically when running via `docker compose up`.

# Database (used when running outside compose; overridden by compose)
DATABASE_URL=postgresql+asyncpg://ukiyo:ukiyo@localhost:5432/ukiyo

# LLM provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Auth. Change in production.
JWT_SECRET=dev-secret-change-me

# Daily tokens_in + tokens_out budget per user.
DAILY_TOKEN_CAP=100000

# Routing Fallback model when no bucket clears the confidence floor.
GENERALIST_MODEL=claude-sonnet-4-6

# Bucket -> model mapping. JSON object.
BUCKET_MODEL_MAP={"coding":"claude-sonnet-4-6","design":"gpt-4o","research":"gemini-2.5-pro"}
